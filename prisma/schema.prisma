generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  name               String              @default("Player")
  mobile             String              @unique
  username           String?             @unique
  email              String?             @unique
  passwordHash       String
  role               String              @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  isActive           Boolean             @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  wallet             Wallet?
  gameRounds         GameRound[]
  depositRequests    DepositRequest[]    @relation("UserDeposits")
  reviewedDeposits   DepositRequest[]    @relation("AdminReviewedDeposits")
  receivedCredits    CreditTransfer[]    @relation("UserCredits")
  grantedCredits     CreditTransfer[]    @relation("AdminGrantedCredits")
  simulationRequests SimulationRequest[]
}

model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float         @default(1000.0) // initial free demo credits
  lockedBalance Float         @default(0.0)
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          String   // "DAILY_BONUS" | "ADMIN_GRANT" | "BET_PLACED" | "BET_WON" | "REFUND"
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  description   String?
  createdAt     DateTime @default(now())
}

model GameRound {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType   String    // "COIN_FLIP" | "DICE" | "MINES" | "AVIATOR" | "WIN_GO" | "DRAGON_TIGER" | "CRAZY_WHEEL" | "PENALTY"
  betAmount  Float
  multiplier Float     @default(0.0)
  payout     Float     @default(0.0)
  status     String    @default("IN_PROGRESS") // "IN_PROGRESS" | "WON" | "LOST" | "CANCELLED" | "REFUNDED"
  serverSeed String    @default(uuid())
  state      String?   // JSON metadata
  createdAt  DateTime  @default(now())
  settledAt  DateTime?
}

model DepositRequest {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation("UserDeposits", fields: [userId], references: [id], onDelete: Cascade)
  amount           Float
  bkashTrxId       String          @unique
  senderNumber     String
  status           String          @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  adminNote        String?
  reviewedById     String?
  reviewedBy       User?           @relation("AdminReviewedDeposits", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  creditTransfer   CreditTransfer?

  @@index([status, createdAt])
  @@index([userId])
}

model CreditTransfer {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation("UserCredits", fields: [userId], references: [id], onDelete: Cascade)
  adminId          String
  admin            User            @relation("AdminGrantedCredits", fields: [adminId], references: [id])
  amount           Float
  reason           String          // "DEPOSIT_APPROVED" | "MANUAL_GRANT" | "BONUS"
  depositRequestId String?         @unique
  depositRequest   DepositRequest? @relation(fields: [depositRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model SimulationRequest {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAmount Float
  notes           String?
  status          String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

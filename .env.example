# Local PostgreSQL Connection (view and manage via local pgAdmin 4)
# Format: postgresql://<user>:<password>@localhost:5432/<database>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bet_demo?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_MOBILE="017XXXXXXXX"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
